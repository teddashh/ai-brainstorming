# Server
HOST=127.0.0.1
PORT=3001
PUBLIC_URL=http://localhost:3001
DB_PATH=./data/ai-brainstorming.db
TRUST_PROXY_HEADERS=false
START_GLOBAL_LIMIT=1000
RUN_GLOBAL_LIMIT=200

# Required for model calls. Uses OpenRouter's OpenAI-compatible chat API.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=AI Brainstorming

# Optional: override model IDs without code changes.
MODEL_CLAUDE=anthropic/claude-sonnet-4
MODEL_GEMINI=google/gemini-2.5-pro
MODEL_GROK=x-ai/grok-4
MODEL_CHATGPT=openai/gpt-4o
MODEL_DEEPSEEK=deepseek/deepseek-r1

# Optional SearXNG instance for neutral evidence bundle.
SEARXNG_URL=

# Optional SMTP. If missing, sessions still work but email is skipped.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=AI Brainstorming
